  anonEv(evOpts, ['trackEvent', eventName, 'typing']);\n    }\n\n    function autoResize() {\n        const is_sticky = bar.classList.contains('sticky');\n        const is_expanded = bar.classList.contains('expanded');\n        if (!is_expanded && textarea.value.length > 300) {\n            textarea.style.height = '70px';\n            inputCard.style.removeProperty('top');\n            return\n        }\n        if (textarea.value.length > 170) {\n            textarea.style.paddingBlock = 0;\n        }\n        if (textarea.value.trim() === '' || textarea.value.length < 50) {\n            textarea.classList.remove('large-prompt');\n            inputCard.style.top = '0px';\n            innerSend.classList.remove('active');\n        }\n        textarea.style.overflow = 'hidden';\n        if (textarea.value.trim() !== '') {\n            textarea.style.height = '70px';\n            //textarea.style.paddingBlock = 0;\n            textarea.style.height = textarea.scrollHeight + 'px';\n            innerSend.classList.add('active');\n        }\n        if (textarea.value.length > 300) {\n            textarea.parentElement.style.alignSelf = 'flex-start';\n            textarea.classList.add('large-prompt');\n        } else {\n            textarea.parentElement.style.alignSelf = 'auto';\n            textarea.classList.remove('large-prompt');\n        }\n    }\n\n    textarea.addEventListener('input', typingEventHandler, {once: true});\n    textarea.addEventListener('input', autoResize);\n    textarea.addEventListener('change', autoResize);\n    // document selector ok since target element should exist outside\n    var stickyTriggerEl = document.querySelector(options.stickyTriggerEl)\n    makeSticky(stickyTriggerEl, bar, {stickyClass: 'sticky', top: options.stickyTopOffset, root: root});\n}\n\nasync function banner_mobile_init(root, evOpts) {\n\n    //mobile banner\n    var mobileBar = root.querySelector('#aicustmob');\n    var non_responsive_page = window.visualViewport.scale < 0.5;  // zoomed out a ton, like Allura non-responsive mobile pages.  Doesn't work from our test suite :(\n    if (mobileBar && !non_responsive_page && !await cookieStore.get('mobile_banner_closed')) {\n        mobileBar.classList.add('visible');\n        anonEv(evOpts, ['trackEvent', 'AI Mobile Footer', 'Impression']);\n\n        var sendbtn = mobileBar.querySelector('.cta');\n        mobileBar.addEventListener('click', async function (e) {\n            e.stopPropagation();\n            e.preventDefault();\n            anonEv(evOpts, ['trackEvent', 'AI Mobile Footer', 'cta']);\n            var url = sendbtn.getAttribute('data-url');\n            window.open(url, '_blank');\n            return false;\n        });\n        var mobileClose = mobileBar.querySelector('.close');\n        mobileClose.addEventListener('click', (e) => {\n            // event stoppage\n            e.stopPropagation();\n            e.preventDefault();\n\n            // close\n            mobileBar.classList.remove('visible');\n\n            // write cookie\n            cookieStore.set({\n                name: 'mobile_banner_closed',\n                value: '1',\n                // expires: Date.now() + 5 * 1000,  // 5 second test\n                expires: Date.now() + 3 * 24 * 60 * 60 * 1000,\n            });\n\n            anonEv(evOpts, ['trackEvent', 'AI Mobile Footer', 'Closed']);\n        });\n    }\n}\n\nfunction fetchContent(options) {\n    let source = options.source;\n    let q = new URLSearchParams(window.location.search);  // starts with ALL current page params\n    q.set('source', source);\n    q.set('host', window.location.host);\n    return window.fetch(`${options.url}?${q.toString()}`)\n        .then(response => {\n            return response.text();\n        })\n        .catch(err => {\n            console.error('Error fetching floating_sitewide content:', err);\n            return '';\n        });\n}\n\nfunction footer_unit_init(options) {\n    // footer unit\n    var mdbEl = document.querySelector(':has(> #mdb-sticky-close)');  // was ID monb-sticky\n    var closeBtn = document.getElementById('mdb-sticky-close');\n    if (mdbEl) {\n        let footer_cta = mdbEl.querySelector('.sticky-cta');\n        options.client = footer_cta.getAttribute('data-label');\n    }\n\n    // Close button: animate out then hide\n    if (closeBtn) {\n        closeBtn.addEventListener('click', function (e) {\n            e.stopPropagation(); // Prevent the container click from firing\n            mdbEl.style.transform = 'translateY(100%)';\n            mdbEl.style.opacity = '0';\n            $.cookie('suppressFloatingContent', true, {\n                expires: 3,\n                path: '/',\n                domain: location.hostname,\n                secure: true\n            });\n            anonEv(options, ['trackEvent', 'Footer Content', 'Closed']);\n            setTimeout(function () {\n                mdbEl.remove();\n            }, 400); // matches the 0.4s transition\n        });\n    }\n\n    // navigate\n    if (mdbEl && isVisible(mdbEl)) {\n        anonEv(options, ['trackEvent', 'Footer Content', 'Impression']);\n        mdbEl.addEventListener('click', function (e) {\n            var cta = mdbEl.querySelector('.sticky-cta');\n            var href = cta.getAttribute('data-url');\n            if (cta && href) {\n                anonEv(options, ['trackEvent', 'Footer Content', 'cta']);\n                window.open(href, '_blank', 'noopener');\n            }\n        });\n    }\n}\n\nfunction isVisible(el, warn = true) {\n    if (!el) return false;\n    const rect = el.getBoundingClientRect();\n    const visible = rect.width > 0 && rect.height > 0;\n    if (!visible && document.readyState !== 'complete' && warn) {\n        console.error('Element not visible, perhaps because document is not ready yet', el);\n    }\n    return visible;\n}\n\nfunction top_banner_loader(options) {\n    fetchContent(options)\n        .then(text => {\n            if (!text) {\n                return;\n            }\n            var shadow = null\n            var topContainer = document.querySelector('#sitewide-top-banner-placeholder') || document.querySelector('#top-banner-placeholder');\n            if (!topContainer) {\n                return;\n            }\n            // modify styles for existing elements to get rid of any gaps\n            if (options.source === 'slashcontent') {\n                topContainer.style.marginBottom = '0px';\n            }\n            // insert top banner content\n            if (options.shadowRoot) {\n                // register animation property before shadow root renders\n                if (CSS.registerProperty) {\n                    try {\n                        CSS.registerProperty({\n                            name: '--retool-angle',\n                            syntax: '<angle>',\n                            initialValue: '0deg',\n                            inherits: false,\n                        });\n                    } catch (e) {\n                    }\n                    try {\n                        CSS.registerProperty({\n                            name: '--angle',\n                            syntax: '<angle>',\n                            initialValue: '0deg',\n                            inherits: false,\n                        });\n                    } catch (e) {\n                    }\n                }\n                shadow = topContainer.shadowRoot || topContainer.attachShadow({mode: 'open'});\n                shadow.innerHTML = text;\n                topContainer.removeAttribute('id'); // make it harder for adblock rules to target whole shadow root container element\n                // load inline script tags code\n                const scripts = shadow.querySelectorAll('script');\n                scripts.forEach(oldScript => {\n                    const newScript = document.createElement('script');\n                    if (oldScript.textContent) {\n                        newScript.textContent = oldScript.textContent;\n                    }\n                    // (If you also want to handle src scripts, add newScript.src = oldScript.src)\n                    shadow.appendChild(newScript);\n                    window.banner_options = options;\n\n                });\n                // load CSS files referenced via link tags\n                const links = shadow.querySelectorAll('link[rel=\"stylesheet\"][href]');\n                links.forEach(oldLink => {\n                    const newLink = document.createElement('link');\n                    newLink.rel = 'stylesheet';\n                    newLink.href = oldLink.href;\n                    document.head.appendChild(newLink);\n                });\n                if (typeof window._luckyPrompts === 'function') {\n                    // execute code that needs to run with the shadow root obj\n                    window._luckyPrompts(shadow);\n                }\n            } else {\n                topContainer.insertAdjacentHTML(options.insertPosition, text);\n            }\n            top_banner_init(shadow, options).catch(err => console.error(err));\n        });\n}\n\nfunction unit_loader(options) {\n    fetchContent(options)\n        .then(text => {\n            if (!text) {\n                return;\n            }\n            var cookieName = 'suppressFloatingContent';\n            if (!!$.cookie(cookieName)) {\n                return;\n            }\n\n            var adContent = '#floating-content';\n            var embedContent = '#floating-embed';\n            var cookieName = 'suppressFloatingContent';\n            var footerMDB = ':has(> #mdb-sticky-close)';\n            var footerContainer = document.querySelector(options.footerEl);\n\n            footerContainer.insertAdjacentHTML(options.insertPosition, text);\n\n            var anonOpts = {source: options.source};\n            // if mdb element is present it means the footer unit is active\n            if