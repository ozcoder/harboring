            "text": "/*jshint ignore:start*/\nfunction isPassiveEventListenerSupported() {\n    var isSupported = false;\n    try {\n        var options = Object.defineProperty({}, \"passive\", {\n            get: function () {\n                isSupported = true;\n            }\n        });\n        window.addEventListener(\"\", null, options);\n    } catch (ex) {\n    }\n    return isSupported;\n}\n\nfunction getAnonEvUrl({source, client, item, action, origin, location}) {\n    const t = /(?:\\.xb\\.|\\.dev\\.)/.test(origin);\n    const is_linux_journal = /linuxjournal/.test(origin)\n    let q = new URLSearchParams();\n    q.append('idsite', t ? 8 : 7);\n    q.append('ca', '1');\n    q.append('rec', '1');\n    q.append('e_c', `${item} | ${client} | ${source}`);\n    q.append('e_a', action || '');\n    q.append('rand', Math.floor(Math.random() * 100000));\n    q.append('url', location);\n    q.append('action_name', item + '-' + (action || ''));\n    const anonSrc = (t || is_linux_journal) ? 'https://sourceforge.net' : origin;\n    const src = `${anonSrc}/software/visit?${q.toString()}`\n    return src;\n}\n\nfunction anonEv({client, source}, _paqArgs) {\n    if (!Array.isArray(_paqArgs) || _paqArgs.length !== 3) {\n        console.debug('Invalid _paqArgs for anonEv:', _paqArgs);\n        return;\n    }\n    var [_, item, action] = _paqArgs;\n    /* see compare.html for more details */\n    const url = getAnonEvUrl({\n        origin: window.location.origin,\n        location: window.location.href,\n        client, source, item, action,\n    })\n\n    var img = new Image();\n    img.src = url;\n    img.style = \"border:0;position:absolute;top:0;\";\n    img.alt = \"\";\n    document.body.appendChild(img);\n}\n\n\nwindow.FloatingNewsletterSubscribe = window.jQuery && (function ($) {\n\n    var _defaults = {\n        element: '#newsletter-floating',\n        delay: 5,\n        cookieName: 'suppressNewsletter',\n        basementEl: 'footer .l-nav-bottom',\n        transition: 'bottom 1s',\n        cookieExpires: 3,\n        bottomOffset: 1000,\n        onShow: function () {\n        },\n        onClose: function () {\n        },\n    };\n\n    function FloatingNewsletterSubscribe(options, cookie_options) {\n        var _self = this;\n        this.settings = $.extend(this.settings, _defaults, options);\n        if (this.settings.delay) {\n            setTimeout(this.init.bind(this), this.settings.delay * 1000);  // doing the delay right away also gives time for Allura ajax to run\n        } else {\n            this.settings.transition = '';\n            this.init();\n        }\n    }\n\n    FloatingNewsletterSubscribe.prototype.init = function () {\n        //init values\n        this.$el = $(this.settings.element);\n        if (!this.$el.length) {\n            return;\n        }\n        this.height = this.$el.outerHeight();\n        this.$el.css('bottom', this.height * (-1));\n        this.suppressCookie = $.cookie(this.settings.cookieName);\n        this.isHidden = true;\n\n        this.$basementEl = $(this.settings.basementEl);\n        this.basementHeight = this.$basementEl.height();    //this doesn't change via MQ's, so can grab it once\n        this.boundScrollDelegate = this.scrollRelocate.bind(this);\n\n        if (this.$el && !this.suppressCookie) {\n            // isPassiveEventListenerSupported available via sticky.js\n            window.addEventListener('scroll', this.boundScrollDelegate, isPassiveEventListenerSupported() ? {passive: true} : false);\n\n            this.show();\n\n            //wire close click\n            $('.btn-closer', this.$el).on(\"click\", this.hide.bind(this));\n        }\n    };\n\n    FloatingNewsletterSubscribe.prototype.scrollRelocate = function () {\n        if (!this.isHidden) {\n            this.$el.css('transition', 'none');\n            this.$el.css('bottom', this.calcBottom());\n        }\n\n    };\n\n    FloatingNewsletterSubscribe.prototype.calcBottom = function () {\n        var windowHeight = \"innerHeight\" in window ? window.innerHeight : document.documentElement.offsetHeight;\n\n        var windowScrollTop = $(window).scrollTop();\n        var scrollBottomLocation = windowHeight + windowScrollTop;\n        var basement = this.$basementEl.offset().top;\n\n        if (scrollBottomLocation < basement) {\n            return 0;\n        } else {\n            return scrollBottomLocation - basement;\n        }\n    };\n\n\n    FloatingNewsletterSubscribe.prototype.show = function () {\n        this.$el.css('transition', this.settings.transition);\n        this.$el.css('bottom', this.calcBottom());\n        this.isHidden = false;\n        this.settings.onShow();\n    };\n\n    FloatingNewsletterSubscribe.prototype.hide = function () {\n        this.$el.css('transition', this.settings.transition);\n        this.$el.css('bottom', this.height * (-1) - this.settings.bottomOffset);\n        this.suppress();\n        this.isHidden = true;\n        this.settings.onClose();\n    };\n\n    FloatingNewsletterSubscribe.prototype.suppress = function () {\n        var host = location.hostname;\n        var domain = host;\n        var parts = host.split('.');\n        if (parts.length > 2) {\n            domain = parts.slice(-2).join('.');\n        }\n        $.cookie(this.settings.cookieName, true, {\n            expires: this.settings.cookieExpires,\n            path: '/',\n            domain: domain,\n            secure: true\n        });\n        return true;\n    };\n\n    return FloatingNewsletterSubscribe;\n})(window.jQuery);\n\nfunction getFloatingSiteWideOrigin() {\n    const scriptTag = document.querySelector('script[src*=\"floating-unit.js\"]');\n    const configuredOrigin = window.SF && window.SF.floatingSitewideOrigin;\n\n    if (configuredOrigin) {\n        try {\n            return new URL(configuredOrigin, window.location.origin).origin;\n        } catch (e) {\n        }\n    }\n\n    if (scriptTag && scriptTag.src) {\n        try {\n            const scriptUrl = new URL(scriptTag.src, window.location.href);\n            if (scriptUrl.hostname === 'a.fsdn.com') {\n                return 'https://sourceforge.net';\n            }\n            if (/\\.xb\\.|\\.dev\\./.test(scriptUrl.hostname)) {\n                scriptUrl.hostname = `sf-${scriptUrl.hostname}`;\n            }\n            return scriptUrl.origin;\n        } catch (e) {\n        }\n    }\n\n    return window.location.origin;\n}\n\nconst _host = getFloatingSiteWideOrigin()\nlet typingTimeoutId = null;\nconst typingPlaceholder = (root) => root.querySelector('#textarea-input')?.getAttribute('data-holder') ?? '';\nlet typingObserver = null;\n\nfunction getBanner(root) {\n    const searchRoot = root || document.getElementById('sitewide-top-banner-placeholder')?.shadowRoot || document;\n    if (!searchRoot || !searchRoot.getElementById) {\n        return null;\n    }\n    return searchRoot.querySelector('[data-banner-name]');\n}\n\nfunction initJazzyBar(root) {\n    var bar = getBanner(root);\n    var placeholder = root.querySelector('#vibe-coding-bar-placeholder');\n    if (placeholder && bar) {\n        placeholder.replaceWith(bar);\n    }\n    const textarea = root.querySelector('textarea#textarea-input');\n    const inputCard = bar.querySelector('.input-card');\n    const fullText = typingPlaceholder(root)\n    let charIndex = 0;\n    let isDeleting = false;\n    let isPaused = false;\n    let timeoutId = null;\n\n    const TYPE_SPEED = 55;\n    const DELETE_SPEED = 30;\n    const PAUSE_AFTER_TYPING_MS = 5000;\n    const PAUSE_AFTER_DELETING_MS = 400;\n\n    if (bar?.getAttribute('data-banner-animations') === 'false') {\n        textarea.placeholder = fullText;\n        inputCard.style.setProperty('animation-play-state', 'paused');\n        inputCard.classList.add('static-animation');\n        return;\n    }\n\n\n    function schedule(nextMs) {\n        clearTimeout(typingTimeoutId);\n        typingTimeoutId = setTimeout(tick, nextMs);\n    }\n\n    function tick() {\n        if (isPaused) return;\n\n        if (!isDeleting) {\n            charIndex++;\n            textarea.placeholder = fullText.slice(0, charIndex);\n\n            if (charIndex >= fullText.length) {\n                // Finished typing — pause 5s then start deleting\n                isDeleting = true;\n                schedule(PAUSE_AFTER_TYPING_MS);\n                return;\n            }\n\n            schedule(TYPE_SPEED);\n            return;\n        }\n\n        // deleting\n        charIndex--;\n        textarea.placeholder = fullText.slice(0, charIndex);\n\n        if (charIndex <= 0) {\n            // Finished deleting — brief pause then retype\n            isDeleting = false;\n            schedule(PAUSE_AFTER_DELETING_MS);\n            return;\n        }\n\n        schedule(DELETE_SPEED);\n    }\n\n    // Pause both the border animation and typewriter when scrolled out of view\n    typingObserver = new IntersectionObserver(\n        ([entry]) => {\n            if (entry.isIntersecting) {\n                isPaused = false;\n                inputCard.classList.remove('paused');\n\n                // Start only if we aren't already running\n                if (!typingTimeoutId) tick();\n            } else {\n                isPaused = true;\n                inputCard.classList.add('paused');\n                clearTimeout(typingTimeoutId);\n                typingTimeoutId = null;\n            }\n        },\n        {threshold: 0}\n    );\n    if (inputCard) {\n        typingObserver.observe(inputCard);\n    }\n}\n\nfunction observeComputedDisplay(el, onChange) {\n    if (!el) return () => {\n    };\n\n    let last = getComputedStyle(el).display;\n\n    const check = () => {\n        const next = getComputedStyle(el).display;\n        if (next !== last) {\n            last = next;\n            onChange(next);\n        }\n    };\n\n    // Run once immediately\n    check();\n\n    // Run on resize (throttled by rAF to avoid spamming during resize)\n    let rafId = 0;\n    const onResize = () => {\n        cancelAnimationFrame(rafId);\n        rafId = requestAnimationFrame(check);\n    };\n\n    window.addEventListener(\"resize\", onResize, {passive: true});\n\n    return () => {\n        window.removeEventListener(\"resize\", onResize);\n        cancelAnimationFrame(rafId);\n    };\n}\n\nfunction makeSticky(triggers, stickyEl, opts = {}) {\n    if (!stickyEl) return () => {\n    };\n\n    const {\n        stickyClass = \"sticky\",\n        top = \"0px\",\n        root = document,          // if you pass a ShadowRoot, we can derive the host wrapper once\n        wrapper = null,       // or pass the wrapper element directly (preferred)\n        zIndex = \"9999\",\n        textInputEl = '.input-card',\n    } = opts;\n    const animationEl = stickyEl.querySelector(textInputEl)\n\n    const pauseAnimation = () => {\n        // stop typing animation\n        animationEl.classList.add('is-paused', 'paused');\n        clearTimeout(typingTimeoutId);\n        typingTimeoutId = null;\n        animationEl.querySelector('textarea').placeholder = typingPlaceholder(root);\n        typingObserver?.disconnect();\n    }\n    const clearPause = () => {\n        // restart typing animation\n        animationEl.classList.remove('is-paused', 'paused');\n        if (!typingTimeoutId) {\n            initJazzyBar(root);\n        }\n    }\n\n    const triggerEls = Array.isArray(triggers) ? triggers : [triggers];\n    const validTriggers = triggerEls.filter(Boolean);\n    let isResized = false\n    const isDesktopViewport = () => window.matchMedia(\"(min-width: 1024px)\").matches;\n    if (validTriggers.length === 0) return () => {\n    };\n\n    const wrapperEl =\n        wrapper ||\n        (root instanceof ShadowRoot ? root.host.closest(\"div\") : null);\n    const prev = wrapperEl\n        ? {\n            position: wrapperEl.style.position,\n            top: wrapperEl.style.top,\n            zIndex: wrapperEl.style.zIndex\n        }\n        : null;\n\n    const setActive = (active) => {\n        stickyEl.classList.toggle(stickyClass, active);\n        const is_expanded = stickyEl.classList.contains('expanded');\n        // to handle pasted large chunks of text\n        if (active) {\n            try {\n                var textarea = stickyEl.querySelector('textarea');\n                stickyEl.parentElement.style.height = 'auto';\n                textarea.blur();\n                if (textarea.value.length > 300 && is_expanded) {\n                    animationEl.style.top = \"90px\";\n                    textarea.style.setProperty('height', '300px', 'important');\n                } else {\n                    animationEl.style.top = \"0px\";\n                }\n            } catch (e) {\n            }\n        } else {\n            animationEl.style.removeProperty('top');\n        }\n        // set the styles on the element itself too for remote sites where the sticky is inside a wrapper parent element\n        if (active && stickyEl && top !== \"0px\") {\n            stickyEl.style.cssText = `top: ${top} !important;`;\n            pauseAnimation()\n        } else {\n            stickyEl.style.top = \"0px\";\n            animationEl.querySelector('textarea').placeholder = '';\n            clearPause()\n        }\n        if (!wrapperEl) return;\n        wrapperEl.classList.toggle(stickyClass, active);\n\n        if (active) {\n            wrapperEl.style.position = \"sticky\";\n            wrapperEl.style.cssText = `top: ${top} !important;`;\n            wrapperEl.style.zIndex = zIndex;\n            pauseAnimation()\n        } else {\n            // restore previous inline styles\n            wrapperEl.style.position = prev.position;\n            wrapperEl.style.top = prev.top;\n            wrapperEl.style.zIndex = prev.zIndex;\n            clearPause()\n        }\n    };\n\n    const createSentinels = () => validTriggers.map((triggerEl) => {\n        const s = document.createElement(\"div\");\n        s.setAttribute(\"aria-hidden\", \"true\");\n        s.style.cssText = \"position:relative;width:1px;height:0px;\";\n        triggerEl.parentNode.insertBefore(s, triggerEl);\n        return s;\n    });\n\n\n    const computeActiveFromRects = () =>\n        validTriggers.some((el) => el.getBoundingClientRect().top <= 0);\n\n    if (\"IntersectionObserver\" in window) {\n        const sentinels = validTriggers.map((triggerEl) => {\n            const s = document.createElement(\"div\");\n            s.setAttribute(\"aria-hidden\", \"true\");\n            s.style.cssText = \"position:relative;width:1px;height:0px;\";\n            triggerEl.parentNode.insertBefore(s, triggerEl);\n            return s;\n        });\n\n        // Track which sentinels are currently visible\n        const visible = new Map(sentinels.map((s) => [s, true]));\n\n        const io = new IntersectionObserver((entries) => {\n            for (const entry of entries) {\n                if (!entry.target.isConnected) continue; // sentinel was removed -> ignore\n                visible.set(entry.target, entry.isIntersecting);\n            }\n            // Sticky ON if ANY sentinel is NOT visible (i.e., scrolled past)\n            const active = Array.from(visible.values()).some((isVis) => !isVis);\n            if (isDesktopViewport()) {\n                setActive(active);\n            } else {\n                sentinels.forEach((s) => {\n                    io.unobserve(s);\n                    visible.delete(s);\n                    s.remove();\n                });\n                sentinels.length = 0;\n                setActive(false);\n            }\n        });\n\n        sentinels.forEach((s) => io.observe(s));\n        const mobileObserver = observeComputedDisplay(root.querySelector(\"#aicustmob\"), (display) => {\n            if (display === \"flex\") {\n                sentinels.forEach((s) => {\n                    io.unobserve(s);\n                    visible.delete(s);\n                    s.remove();\n                });\n                sentinels.length = 0;\n                setActive(false);\n                isResized = true\n            }\n            if (!isResized) {\n                return\n            }\n            // Recreate sentinels (because you removed them)\n            const newSentinels = createSentinels();\n            newSentinels.forEach((s) => {\n                visible.set(s, true);\n                io.observe(s);\n            });\n            sentinels.splice(0, sentinels.length, ...newSentinels);\n            setActive(computeActiveFromRects());\n        });\n        return () => {\n            io.disconnect();\n            sentinels.forEach((s) => s.remove());\n            setActive(false);\n            mobileObserver()\n        };\n    }\n\n    // Fallback: scroll/resize\n    const onScroll = () => setActive(computeActiveFromRects());\n\n    window.addEventListener(\"scroll\", onScroll, {passive: true});\n    window.addEventListener(\"resize\", onScroll);\n    onScroll();\n\n    return () => {\n        window.removeEventListener(\"scroll\", onScroll);\n        window.removeEventListener(\"resize\", onScroll);\n        setActive(false);\n    };\n}\n\n\nasync function top_banner_init(root, options = {}) {\n    root = root || document;\n    var bar = getBanner(root);\n\n    var bannerName = bar?.getAttribute('data-banner-name') || root.querySelector('#aicustmob')?.getAttribute('data-mobile-name');\n\n    var evOpts = {\n        client: bannerName,\n        source: options.source,\n    }\n\n    banner_mobile_init(root, evOpts);\n\n    if (!bar) return;\n\n    if (options.source === 'slashdot') {\n        bar?.setAttribute('data-banner-animations', 'false');\n    }\n    initJazzyBar(root);\n\n    var textarea = bar.querySelector('#textarea-input');\n    var suggestions = () => bar.querySelector(\".suggestions\");\n    var eventName = 'AI Bar';\n    var innerSend = bar.querySelector('.send-btn');\n    var row = bar.querySelector('.row');\n    var inputCard = bar.querySelector('.input-card');\n\n    // Guard in case markup changes\n    if (!textarea) return;\n\n    // have to wait a while for visibility check for this element - not even domready is good enough, don't want to wait for all the way for 'load'\n    let tryTrackAttempts = 0;\n\n    function tryTrack() {\n        if (isVisible(row, false)) {\n            anonEv(evOpts, ['trackEvent', eventName, 'Impression']);\n        } else if (++tryTrackAttempts < 20) {\n            setTimeout(tryTrack, 100);\n        }\n    }\n\n    tryTrack();\n\n    function fetchExpandedContent() {\n        if (suggestions()) {\n            suggestions().style.display = 'flex';\n            return;\n        }\n        fetchContent({source: options.source, url: '/user/top_sitewide_expanded'})\n            .then(text => {\n                bar.insertAdjacentHTML('beforeend', text);\n                if (suggestions()) {\n                    suggestions().style.display = 'flex'\n                }\n                textarea.removeEventListener(\"focus\", fetchExpandedContent);\n                setupButtonsCards();\n            });\n    }\n\n    function expand() {\n        root.host?.style.setProperty('height', 'auto');\n        if (arguments && arguments[0] && arguments[0].target && arguments[0].target.classList.contains('send-btn')) {\n            return;\n        }\n        if (bar.classList.contains('expanded')) {\n            return;\n        }\n        if (options.source === 'sf' || options.source === 'sd' || options.source === 'tbs') {\n            fetchExpandedContent();\n        }\n        anonEv(evOpts, ['trackEvent', eventName, 'Expand']);\n        bar.classList.add('expanded');\n        if (suggestions()) {\n            suggestions().style.display = 'flex';\n            autoResize();\n        }\n\n        // disable delayed redirs on DLP/TYP\n        if (window.SF) {\n            window.SF.noRedirect = true;\n        }\n        if (window.SF?.downloader) {\n            window.SF.downloader.cancelRedirect()\n        }\n    }\n\n    function collapse() {\n        root.host?.style.setProperty('height', '100px');\n        if (!suggestions() || !bar.classList.contains('expanded')) {\n            return;\n        }\n        anonEv(evOpts, ['trackEvent', eventName, 'Collapse']);\n        bar.classList.remove('expanded');\n        if (suggestions()) {\n            suggestions().style.display = 'none';\n            autoResize();\n        }\n    }\n\n    textarea.addEventListener('mousedown', function () {\n        // The mousedown that gives focus will also produce a click on the bar.\n        expand();\n        // Capture that click and kill it.\n        bar.addEventListener('click', function suppress(e) {\n            if (e.target !== bar) return;\n            e.stopPropagation();\n        }, {capture: true, once: true});\n    });\n    textarea.addEventListener('click', function (e) {\n        e.stopPropagation(); // never let textarea clicks reach the bar handler\n    });\n    // stop any key events from propagating to avoid conflicts with sitewide shortcuts in OG SD\n    ['keydown', 'keypress', 'keyup'].forEach(function (type) {\n        textarea.addEventListener(type, function (e) {\n            e.stopPropagation()\n        }, {capture: true});\n    });\n\n    // main bar\n    bar.addEventListener('click', function (e) {\n        if (e.target !== e.currentTarget) return; // if click is not from bar element then return\n        anonEv(evOpts, ['trackEvent', eventName, 'cta-bar']);\n        var url = innerSend.getAttribute('data-url');\n        url += encodeURIComponent(textarea.value);\n        if (url.includes('{VARIATIONS_HERE}')) {\n            url = url.replace('{VARIATIONS_HERE}', encodeURIComponent(textarea.value))\n        }\n        window.open(url, '_blank');\n    });\n\n    // \"Click outside\" that works for both document AND shadow DOM.\n    // - If root is a Document, we can listen on it.\n    // - If root is a ShadowRoot, listen on document but use composedPath().\n    var clickTarget = (root && root.nodeType === 9) ? root : document;\n    clickTarget.addEventListener('click', function (e) {\n        var path = (typeof e.composedPath === 'function') ? e.composedPath() : null;\n        var clickedInside = path ? path.indexOf(bar) !== -1 : bar.contains(e.target);\n        if (!clickedInside) {\n            textarea.classList.remove('large-prompt');\n            collapse();\n        }\n    });\n\n    if (innerSend) {\n        let goToSite = function (e) {\n            e.preventDefault();\n            anonEv(evOpts, ['trackEvent', eventName, 'cta']);\n            var url = innerSend.getAttribute('data-url');\n            url += encodeURIComponent(textarea.value);\n            if (url.includes('{VARIATIONS_HERE}')) {\n                url = url.replace('{VARIATIONS_HERE}', encodeURIComponent(textarea.value))\n            }\n            window.open(url, '_blank');\n        };\n        innerSend.addEventListener('click', function (evt) {\n            evt.stopPropagation();\n            goToSite(evt);\n        });\n        row.addEventListener('click', goToSite);\n    }\n\n    function setupButtonsCards() {\n        var pillBtns = bar.querySelectorAll('.suggestions .pills button');\n        pillBtns.forEach(function (btn) {\n            btn.addEventListener('click', function () {\n                var prompt = btn.getAttribute('data-full-prompt') || btn.textContent.trim();\n                var promptURL = btn.getAttribute('data-prompt-url')\n                textarea.value = prompt;\n                textarea.setSelectionRange(0, 0);\n                textarea.dispatchEvent(new Event('input', {bubbles: true}));\n                textarea.focus();\n                if (innerSend) {\n                    if (!promptURL) {\n                        var url = innerSend.getAttribute('data-url');\n                        url += encodeURIComponent(textarea.value);\n