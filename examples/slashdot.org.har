 .comments {\nmargin-top:20px;\n}\n\n#clickgen .tlnav {\nbackground: #cccccc;\ndisplay: inline-block;\nwidth: auto;\ntext-transform: uppercase;\nfont-size: .85em;\npadding:.25em .75em;\nmargin:0;\nposition:absolute;\nborder-radius:0 0 .4em 0;\n-moz-border-radius:0 0 .4em 0;\n-webkit-border-radius:0 0 .4em 0;\nleft:0;\n}\n\n#clickgen .tlnav a {\ncolor:#ffffff;\n}\n\n#clickgen .st > .f {\nborder-bottom: 0;\n}\n\n#clickgen .st > section {\nheight:90px;\n}\n\n#clickgen.b .f > div {\nmargin-top: 0;\nheight:181px;\nposition:relative\n}\n\n#clickgen .st div p a {\nfont-size:1.05em;\ntext-decoration:underline;\n}\n\n#clickgen .st div p {\npadding-top:.5em;\n}\n\n#clickgen.b .st div {\nposition: relative;}\n\n.btn.link.slashtvico {\nposition: relative;\ndisplay: inline;\noverflow: visible;\nmargin-top: -3px;\nwidth:36px;\n}\n\n.btn.link.slashtvico > span {\nheight: 30px;\ndisplay: inline-block;\nposition: absolute;\nbackground:transparent url(//a.fsdn.com/sd/menu_slashtv2.png) no-repeat 0 0;\ntext-indent: -999999px;\nwidth: 36px;\nleft:0;\n}\n\n/*Job board*/\n#jobBoardHeader{\n\tbackground-color:rgb(0,102,102);\n\theight:175px;\n\ttext-align: center;\n}\n#jobBoardHeader h1{\n\tfont-family:Helvetica, sans-serif;\n\tfont-size:30px;\n\tfont-weight:bold;\n\tcolor: #fff;\n\ttext-shadow:1px 1px 2px rgba(0,0,0,0.4);\n\tpadding-top:15px;\n}\n#jobBoardHeader fieldset{\n\tbackground-color:rgb(0,66,66);\n\twidth:50%;\n\theight:58px;/* SMACKS: CHANGE 38px to 58px*/\n\tpadding: 10px;\n\tborder-radius:3px;\n\tbox-shadow:inset 1px 1px 2px rgba(0,0,0,0.65);\n\tmargin: 0 auto;\n\tborder-color:rgb(0,102,102);\n}\n#jobBoardHeader input[type=text]{\n\tbackground-color:rgb(255,255,255);\n\theight:35px;\n\tborder-color:rgb(17,17,17);\n\tborder-width:1px;\n\tborder-radius:4px;\n\tborder-style:solid;\n\tbox-shadow:inset 2px 2px 4px rgba(0,0,0,0.4);\n\tmin-width: 0;\n\tpadding: 0 5px;\n\tmargin-right: 10px;\n}\n#jobBoardHeader input[type=submit]{\n\tbackground-image:-webkit-gradient(linear, 0% 0%, 0% 100%, from(rgb(0,127,127)), to(rgb(0,106,106))) !important;\n\twidth:116px;\n\theight:37px;\n\tborder-color:rgb(0,66,66);\n\tborder-width:1px;\n\tborder-radius:4px;\n\tborder-style:solid;\n\tbox-shadow:1px 1px 2px rgba(0,0,0,0.2);\n\tfont-size:15px;\n\tfont-weight:bold;\n\ttext-shadow: none;\n\tcolor: #fff !important;\n}\n#jobBoardBody{\n\tpadding:20px;\n\tmargin-right: 233px;\n}\n#jobBoardBody thead tr{\n\tborder:none;\n}\n#jobBoardBody thead tr th{\n\tcolor: #fff;\n\ttext-shadow: none;\n\tpadding: 10px;\n\tbackground-image: -webkit-gradient(linear, 0% 0%, 0% 100%, from(#666), to(#444));\n\tbackground-image: -moz-linear-gradient(100% 100% 90deg, #444, #666 100%);\n\tbackground-image: -o-linear-gradient(top, #666,#444 100%);\n}\n#jobBoardBody thead th a {\n\tcolor: #fff;\n}\n\n#jobBoardBody thead th:first-child {\n\tborder-top-left-radius:4px\n}\n\n#jobBoardBody thead th:last-child {\n\tborder-top-right-radius:4px\n}\n#jobBoardBody tbody tr{\n\tborder: 1px solid rgb(190,190,190);\n\tborder-width: 0 1px 0 1px;\n}\n#jobBoardBody tbody tr:last-child{\n\tborder-bottom-width: 1px;\n}\n#jobBoardBody tbody tr:first-child {\n\t background-color: #fff;\n}\n#jobBoardBody tbody tr:nth-child(even) {\n\t background-color: #eee;\n}\n#jobBoardBody tbody td.no_results{\n\ttext-align: center;\n\tfont-weight: bold;\n}\n#jobBoardBody tbody td.post_date{\n\tpadding-right: 1px;\n}\n#jobBoardBanner{\n\tfloat: right;\n\t/*width: 213px; SMACKS 2/4*/\n    /*SMACKS CHANGED TOP FROM 49PX TO 49px*/\n\tmargin: 49px 20px 10px 10px;\n}\n#jobBoardBanner .poweredBy{\n\tfont-weight: bold;\n\tvertical-align: top;\n\tmargin-top: 10px;\n\ttext-align: right;\n}\n\n.dicebutton {\n\tbackground-color:#f8f8f8;\n\ttext-indent:0;\n\tborder:1px solid #dcdcdc;\n\tdisplay:inline-block;\n\tcolor:#777777;\n\tfont-family:arial;\n\tfont-size:12px;\n\tfont-weight:bold;\n\tfont-style:normal;\n\theight:40px;\n\tline-height:40px;\n\twidth:100%;  /*SMACKS CHANGED FROM 193PX TO 100%*/\n\tpadding: 0 10px;\n\ttext-decoration:none;\n\ttext-align:left;\n\ttext-indent:5px;\n}\n\n.dicebutton:hover {\n\tbackground-color:#006663;\n\tcolor:#FFF;\n\ttext-decoration: none;\n}\n\n#dicediv {\n\tdisplay:block;\n\twidth:213px;\n}\n\n.diceheader {\n\tbackground-color:#424242;\n\t-webkit-border-top-left-radius:0px;\n\t-moz-border-radius-topleft:0px;\n\tborder-top-left-radius:0px;\n\t-webkit-border-top-right-radius:11px;\n\t-moz-border-radius-topright:11px;\n\tborder-top-right-radius:15px;\n\t-webkit-border-bottom-right-radius:0px;\n\t-moz-border-radius-bottomright:0px;\n\tborder-bottom-right-radius:0px;\n\t-webkit-border-bottom-left-radius:0px;\n\t-moz-border-radius-bottomleft:0px;\n\tborder-bottom-left-radius:0px;\n\tbackground-image: -webkit-gradient(linear, 0% 0%, 0% 100%, from(#666), to(#444));\n\tbackground-image: -moz-linear-gradient(100% 100% 90deg, #444, #666 100%);\n\tbackground-image: -o-linear-gradient(top, #666,#444 100%);\n\ttext-indent:5px;\n\tborder:1px solid #424242;\n\tdisplay:inline-block;\n\tcolor:#ededed;\n\tfont-family:arial;\n\tfont-size:13px;\n\tfont-weight:bold;\n\tfont-style:normal;\n\theight:38px;\n\tline-height:38px;\n\twidth:100%; /*SMACKS: CHANGED 193PX TO 100%*/\n\tpadding: 0 10px;\n\ttext-decoration:none;\n\ttext-align:left;\n}\n\n.dicebottom {\n\tbackground-color:#f8f8f8;\n\tborder:1px solid #dcdcdc;\n\tdisplay:inline-block;\n\tcolor:#777777;\n\tfont-family:arial;\n\tfont-size:16px;\n\tfont-weight:bold;\n\tfont-style:normal;\n\theight:155px;\n\twidth:100%; /*SMACKS: CHANGED 193PX TO 100%*/\n\tpadding: 0 10px;\n\ttext-decoration:none;\n\ttext-align:center;\n\tpadding-top:10px;\n}\n\n.dicegreenbutton {\n\tbackground-color:#01a89e;\n\ttext-indent:0;\n\tborder:1px solid #dcdcdc;\n\tdisplay:inline-block;\n\tcolor:#ededed;\n\tfont-family:arial;\n\tfont-size:16px;\n\tfont-weight:bold;\n\tfont-style:normal;\n\theight:50px;\n\tline-height:50px;\n\twidth:138px;\n\ttext-decoration:none;\n\ttext-align:center;\n\tmargin-top:10px;\n\tmargin-bottom:10px;\n\tmargin-left:9px;\n\tmargin-right:10px;\n}\n\n.dicegreenbutton:hover {\n\tbackground-color:#006663;\n\tcolor:#FFF;\n\ttext-decoration: none;\n}\n\n.diceplain {\n\ttext-decoration:none;\n\tfont-family:arial;\n\tfont-size:12px;\n\tcolor:#424242;\n}\n\n.diceplain:hover {\n\ttext-decoration:underline;\n}\n\n.diceimg {\n\tfloat:left;\n\tpadding-left:10px;\n}\nbody.job_board form.dice_job_search_form{\n\toverflow: auto;\n}\n#page_display {\n\tfloat: right;\n}\n#how_many_per_page {\n\tfloat: right;\n\tpadding-right: 180px;\n}\n#item_count {\n\tpadding-right: 50px;\n}\nsection#dice_jobs-content{\n\tpadding: 0;\n}\n#slashboxes section ul#dice_widget{\n\tmargin: 0 20px;\n}\n#slashboxes section ul#dice_widget li{\n\tborder-color: #ccc;\n\tborder-style: solid;\n\tborder-width: 0 0 1px 0;\n\tpadding: 5px;\n\toverflow: auto;\n}\n#slashboxes section ul#dice_widget li:last-child{\n\tborder-bottom-width: 0px;\n}\n#slashboxes section ul#dice_widget li:hover{\n\tbackground-color: rgba( 0, 102, 102, 0.35 );\n}\n#slashboxes section ul#dice_widget li:hover:last-child{\n\tbackground-color: transparent;\n}\n#slashboxes section ul#dice_widget a:hover{\n\ttext-decoration: none;\n}\n#slashboxes section ul#dice_widget a{\n\tdisplay: block;\n}\n#all_jobs{\n\tfont-weight: bold;\n\tcolor: rgb(0,102,102);\n\tfloat: left;\n}\n#dice_logo_sm{\n\tfloat: right;\n}\n#slashboxes section ul#dice_widget #dice_logo_sm a{\n\tdisplay:inline;\n}\n#jobBoardWidgetSearchForm {\n\theight: 40px;\n\tbackground-color: rgb(248,248,248);\n\tborder-bottom: 1px solid #ccc;\n}\n#jobBoardWidgetSearchForm input[type=text]{\n\tbackground-color:rgb(255,255,255);\n\theight:25px;\n\twidth:143px;\n\tborder-width:1px;\n\tborder-radius:4px;\n\tborder-style:solid;\n\tmin-width: 0;\n\tpadding: 0 5px;\n\tmargin-right: 5px;\n\tpadding-left: 5px;\n}\n#jobBoardWidgetSearchForm input[type=submit]{\n\tbackground-image:-webkit-gradient(linear, 0% 0%, 0% 100%, from(rgb(0,127,127)), to(rgb(0,106,106))) !important;\n\twidth:70px;\n\theight:25px;\n\tborder-color:rgb(0,66,66);\n\tborder-width:1px;\n\tborder-radius:4px;\n\tborder-style:solid;\n\tbox-shadow:1px 1px 2px rgba(0,0,0,0.2);\n\tfont-size:12px;\n\tfont-weight:bold;\n\ttext-shadow: none;\n\tcolor: #fff !important;\n}\n#jobBoardWidgetSearchForm fieldset{\n\tpadding-top: 7px;\n\tpadding-left: 18px;\n}\n\n/*****************************************************\n\t\tSubmission Form Styles\n******************************************************/\n\n.clearfix:after {\n\t\tcontent: \".\";\n\t\tdisplay: block;\n\t\tclear: both;\n\t\tvisibility: hidden;\n\t\tline-height: 0;\n\t\theight: 0;\n}\n\n.clearfix {\n\t\tdisplay: inline-block;\n}\n\nhtml[xmlns] .clearfix {\n\t\tdisplay: block;\n}\n\n* html .clearfix {\n\t\theight: 1%;\n}\n\n#form-wrapper {\n\t\twidth: 60%;\n\t\tmargin: 0 auto;\n}\n\n.no-margin { margin-bottom: 0; }\n\nhgroup > p { color: #676767; }\n\n.sd-form-header {\n\n    font-size: 1.5rem; /*SMACKS CHANGED FROM 2em*/\n    margin-bottom: 0;\n}\n.sd-brand-color { color: #2E2E2E; } /*SMACKS: CHAGNE BRAND COLOR*/\n\na.sd-brand-color { text-decoration: underline; }\n\n\n.sd-form-label {\n    width: 90%;\n    display: block;\n    margin-bottom: 5px;\n    text-align: left;\n    font-size: 1.5em;\n    font-weight: bold;\n }\n.sd-well {\n    color: #797979;\n    width: 90%; /*SMACKS: CHANGED PERCENTAGE FROM 93 TO 90 FOR STORY SUBMIT*/\n    padding: 17px;\n    border-radius: 5px;\n    border: 1px solid #CCC;\n    background-color: #F1F1F1;\n}\n\n\n.sd-well-info a {\n\t\tcolor: #004E4E;\n\t\tfont-weight: bold;\n}\n\n\n#editor input[type=\"text\"], #editor .prel input[type=\"text\"], #firehose > #editor textarea[name=\"introtext\"] {\n    width: 100%;\n    padding: 10px;\n}\n\n#editor textarea[name=\"introtext\"] { margin-bottom: 10px; width:90%; } /*SMACKS CHANGED WIDTH FROM 97% TO 90%*/\n\n#editor input[type=\"text\"], #editor .prel input[type=\"text\"], #firehose > #editor textarea[name=\"introtext\"] {\n    width: 90%;  /*SMACKS CHANGED WIDTH FROM 97% TO 90%*/\n    padding: 10px;\n}\n\nlabel.sd-brand-color span {\n\t\tcolor: #666666;\n\t\tfont-size: .75em;\n\t\tfont-weight: normal;\n}\n\n.pull-right { float: right; }\n\n.pull-left { float: left; }\n\nlabel.pull-right { width: 160px; }\n\n\n#form-controls {\n\t\twidth: 100%;\n\t\tline-height: 50px;\n}\n\n#form-controls .sd-btn, button,#form-controls input[type=submit], input[type=reset], #form-controls input[type=button] {\n    height: auto;\n    display: inline;\n    font-size: 1rem;\n    font-weight: normal !important;\n    line-height: 25px;\n    margin: 0 0 40px 0;\n    margin-right: 10%;\n    padding: 5px 20px 5px;\n    text-decoration: none;\n    color: #FFF !important;\n    text-align: center;\n    position: relative;\n    border-top: 1px solid #004D4E;\n    border-left: 1px solid #004D4E;\n    border-right: 1px solid #004D4E;\n    border-radius: 5px;\n    -o-border-radius: 5px;\n    -moz-border-radius: 5px;\n    background: #004D4E;\n}\n\n#form-controls .sd-btn:hover, #form-controls button:hover, #form-controls input[type=submit]:hover, #form-controls input[type=reset]:hover, #form-controls input[type=button]:hover {\n    background: #003b3c; /* Old browsers */\n    background: -moz-linear-gradient(top,  #004d4e 0%, #007c7c 100%) !important; /* FF3.6+ */\n    background: -webkit-gradient(linear, left top, left bottom, color-stop(0%,#004d4e), color-stop(100%,#007c7c)) !important; /* Chrome,Safari4+ */\n    background: -webkit-linear-gradient(top,  #004d4e 0%,#007c7c 100%) !important; /* Chrome10+,Safari5.1+ */\n    background: -o-linear-gradient(top,  #004d4e 0%,#007c7c 100%) !important; /* Opera 11.10+ */\n    background: -ms-linear-gradient(top,  #004d4e 0%,#007c7c 100%) !important; /* IE10+ */\n    background: linear-gradient(to bottom,  #004d4e 0%,#007c7c 100%) !important; /* W3C */\n    filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#004d4e', endColorstr='#007c7c',GradientType=0 ) !important; /* IE6-9 */\n}\n\n/***************************************\n\t\tCONFIRMATION WRAP\n****************************************/\n\n#confirmation-wrap    { color: #424242; }\n#confirmation-wrap h2 { font-size: 1.6em; }\n#confirmation-wrap h4 { font-size: 1.2em; margin-bottom: 2.4em; }\n#confirmation-wrap p { margin-bottom: 5em; }\n\n.social-share      { margin-bottom: 20px; width: 390px; }\n.social-share span { line-height: 40px; font-weight: bold; }\n.social-share ul   { margin: 0; padding: 0; float: right; }\n.social-share li {\n\t\tlist-style: none;\n\t\tpadding: 0;\n\t\tfloat: left;\n\t\tmargin-left: 15px;\n}\n.social-share li a {\n\t\tdisplay: block;\n\t\ttext-indent: -9999px;\n\t\theight: 47px;\n\t\twidth: 47px;\n\t\tbackground: url(\"//a.fsdn.com/sd/classic/img/social-icon-sprite.png\") no-repeat;\n}\n\n.social-share li a.fb { background-position: 0 0; }\n\n.social-share li a.tw { background-position: -58px 0; }\n\n.social-share li a.gp { background-position: -116px 0; }\n\n.social-share li a.fb:hover { background-position: 0 -58px; }\n\n.social-share li a.tw:hover { background-position: -58px -58px; }\n\n.social-share li a.gp:hover { background-position: -116px -58px; }\n\n\n/***************************************\n\tMODAL WINDOW\n****************************************/\n\n.overlay {\n\tdisplay: none;\n\tposition: fixed;\n\ttop: 0;\n\tleft: 0;\n\twidth: 100%;\n\theight: 100%;\n\tbackground: rgba(0, 0, 0, .7);\n\tz-index: 100;\n}\n\n.modal-box, .modal-box footer {\n\t\tborder-bottom-left-radius: 10px;\n\t\tborder-bottom-right-radius: 10px;\n\t\t-o-border-bottom-left-radius: 10px;\n\t\t-o-border-bottom-right-radius: 10px;\n\t\t-ms-border-bottom-left-radius: 10px;\n\t\t-ms-border-bottom-right-radius: 10px;\n\t\t-moz-border-bottom-left-radius: 10px;\n\t\t-moz-border-bottom-right-radius: 10px;\n\t\t-webkit-border-bottom-left-radius: 10px;\n\t\t-webkit-border-bottom-right-radius: 10px;\n}\n\n.modal-box {\n\tdisplay:none;\n\tposition: absolute;\n\tpadding: 10px;\n\tz-index: 101;\n\tmin-width: 400px;\n\tmin-height: 200px;\n\tbackground-color: #FFF;\n\tborder-top: 4px solid rgb(0,102,102);\n\tbox-shadow: rgba(0,0,0,.6) 0px 2px 12px;\n\t-o-box-shadow: rgba(0,0,0,.6) 0px 2px 12px;\n\t-ms-box-shadow: rgba(0,0,0,.6) 0px 2px 12px;\n\t-moz-box-shadow: rgba(0,0,0,.6) 0px 2px 12px;\n\t-webkit-box-shadow: rgba(0,0,0,.6) 0px 2px 12px;\n}\n\n.modal-box, .modal-box footer {\n\tborder-bottom-left-radius: 10px;\n\tborder-bottom-right-radius: 10px;\n\t-o-border-bottom-left-radius: 10px;\n\t-o-border-bottom-right-radius: 10px;\n\t-ms-border-bottom-left-radius: 10px;\n\t-ms-border-bottom-right-radius: 10px;\n\t-moz-border-bottom-left-radius: 10px;\n\t-moz-border-bottom-right-radius: 10px;\n\t-webkit-border-bottom-left-radius: 10px;\n\t-webkit-border-bottom-right-radius: 10px;\n}\n\n.modal-box header h3 {\n\twidth: 105px;\n\theight: 15px;\n\tmargin: 10px;\n\ttext-indent: -9999px;\n\tbackground: url(\"//a.fsdn.com/sd/logo.png\") no-repeat;\n}\n\n#close-modal {\n\tposition: absolute;\n\tbackground:url('//a.fsdn.com/sd/classic/img/glyphish-icons-16.png') 0 0 no-repeat;\n\tbackground-position: -5px -5px;\n\twidth: 25px;\n\theight: 25px;\n\tdisplay: block;\n\ttext-indent:-9999px;\n\ttop: 10px;\n\tright: 5px;\n}\n\n.modal-box footer {\n\tborder-top: 1px solid #CCC;\n\tbackground-color: #F4F4F4;\n\tbottom: 0;\n\theight: 35px;\n\tleft: 0;\n\tposition: absolute;\n\twidth: 100%;\n}\n\n/***************************************\n\t Submission form Accordion\n****************************************/\n\n#option-controls h4 {\n\t\tline-height: 30px;\n\t\tcolor: #004E4E;\n\t\tpadding: 5px 15px;\n\t\tbackground-color: #F4F4F4;\n\t\tborder: 1px solid #CCC;\n\t\tcursor: pointer;\n}\n\n#option-controls h4:hover {\n\t\tbackground-color: #FFF;\n}\n\n#option-controls ul {\n\t\tmargin: 0;\n\t\tpadding: 0;\n\t\tlist-style: none;\n\t\tline-height: 35px;\n}\n\n#option-controls textarea {\n\t\twidth: 98%;\n\t\tmargin-top: 5px;\n}\n\n#mediaupload { padding: 15px; }\n\n#editor input[type=\"text\"].createtime { width: 25%; }\n\n/******************************************\n\tStyles for Interstitial Modal\n*******************************************/\n.vail {\n\twidth: 100%;\n\theight: 100%;\n\tposition: fixed;\n\ttop: 0;\n\tleft: 0;\n\tbackground-color: rgba(0, 0, 0, 0.85);\n\tfilter:progid:DXImageTransform.Microsoft.alpha(opacity=90);\n\tz-index: 100;\n\t}\n.interstitial_wrap {\n\tbackground-color: #fff;\n\tposition: fixed;\n\ttop: 50px;\n\tz-index: 101;\n}\n.interstitial_content {\n\tposition: relative;\n}\n\n.interstitial_message {\n\ttext-align: right;\n\tline-height: 30px;\n\tpadding: 10px 15px;\n}\n\n.close_modal {\n\tcolor: #ffffff;\n\tfont-size: 1em;\n\tpadding: 5px 10px;\n\tbackground-color: #000;\n\tposition: absolute;\n\ttop: 0px;\n\tright: 0px;\n\tcursor: pointer;\n}\n/*************************************\n\timage-uploader\n**************************************/\n.imgup-text{\n\tbackground-color: #dcedf5;\n\tpadding: 5px;\n\tborder-radius: 4px;\n\tline-height: 20px;\n}\n.imgup-text span{\n\tcolor: #4c86ab;\n}\n.imgup-attr label{\n\ttext-align: left;\n}\n.imgup-attr h3 {color: #1c4d47; font-size: 1.2em;}\n.imgup-attr{\n\tmargin-bottom: 50px;\n}\n.imgup-btn{\n\tmargin-bottom: 70px;\n}\n\n/* Source Forge Css */\n.sf_widget {\n\tmargin: 0 20px;\n}\n.sf_widget li {\n\tborder-color: #ccc;\n\tborder-style: solid;\n\tborder-width: 0 0 2px 0;\n\toverflow: auto;\n}\n.sf_widget li a span {\n\tcolor: #909a9a;\n}\n.sf_widget li a span.sf-size {\n\tfloat: right;\n}\n#sf-logo a {\n\tbackground: url(//a.fsdn.com/sd/sf-logo.png) no-repeat;\n\ttext-indent: -9999px;\n\theight: 35px;\n\tdisplay: block;\n\twidth: 200px;\n\tmargin-left: 65px;\n}\n#sf-logo p {\n\tfloat: left;\n\tline-height: 34px;\n\tmargin-left: -15px;\n}\n\n.new-tag\n{ color: rgb(255, 255, 255); font-weight: 600; text-transform: uppercase; display: inline-block; font-size: 0.6rem; line-height: 0.6rem; background-color: rgb(217, 83, 79); padding: 3px 5px; border-radius: 4px; position: relative; top: -2px; text-shadow:none; }\n\n/***************************************\n\t Ads\n****************************************/\n#div-gpt-ad-728x90_b {\n\twidth: 720px;\n\theight: 90px;\n\tmargin-left: auto;\n\tmargin-right: auto;\n}\n/***************************************\n\tSlashdot Deals\n****************************************/\n.sd-mini-logo {\n\tdisplay: inline-block;\n\twidth: 12px;\n\theight: 12px;\n\tbackground: url(//a.fsdn.com/sd/slashdot_favicon_white.png) no-repeat;\n}\n/***************************************\n\t Message bubble home page\n****************************************/\n#firehose > .grid_24 > .msg,\n#firehose-message-tray.msg {\n\twidth: 64%;\n\tmargin-top: -2px;\n\tmargin-left: 120px;\n\tmargin-bottom: -9px !important;\n\tposition: relative;\n\tfloat:left;\n}\n\n/*******************************************\n\tVideo Detail Styles to be moved to SASS\n********************************************/\n\n/* This is just to display the video player */\n.video-wrapper {\n\t\theight: 450px;\n\t\tbox-shadow: 2px 2px 1px rgba(0, 0, 0, 0.3);\n\t\tmargin-top: 20px;\n}\n\n/* Ooyala Player style overrides */\n.video-wrapper .innerWrapper:-webkit-full-screen {\n\twidth: 100% !important;\n\theight: 100% !important;\n}\n.video-wrapper .oo_controls {\n\twidth: 100% !important;\n\tleft: 0 !important;\n}\n.video-wrapper .oo_buffer_progress {\n\tbackground-color: #80b2b2 !important;\n}\n.video-wrapper .oo_playhead_progress {\n\tbackground-color: #006666 !important;\n}\n.video-wrapper .oo_full_controls .oo_playhead {\n\ttop: -4px !important;\n cursor: pointer;\n}\n\n/* This is the SASS version */\n/*.video-wrapper {\n\theight: 360px;\n\tbox-shadow: 2px 2px 1px rgba(0, 0, 0, 0.3);\n\tmargin-top: 20px;\n\t// Ooyala Player style overrides\n\t.innerWrapper:-webkit-full-screen {\n\t\twidth: 100% !important;\n\t\theight: 100% !important;\n\t}\n\t.oo_controls {\n\t\twidth: 100% !important;\n\t\tleft: 0 !important;\n\t}\n\t.oo_buffer_progress { background-color: #80b2b2 !important; }\n\t.oo_playhead_progress { background-color: #006666 !important; }\n\t.oo_full_controls {\n\t\t.oo_playhead {\n\t\t\ttop: -4px !important;\n\t\t\tcursor: pointer;\n\t\t}\n\t}\n}*/\n\n\n/* CCPA Privacy Modal (background) */\n.modal-custom {\n  display: none; /* Hidden by default */\n  position: fixed; /* Stay in place */\n  z-index: 1; /* Sit on top */\n  padding-top: 100px; /* Location of the box */\n  left: 0;\n  top: 0;\n  width: 60%; /* Full width */\n  height: 100%; /* Full height */\n  overflow: no-display; /* Enable scroll if needed */\n  background-color: rgb(0,0,0); /* Fallback color */\n  background-color: rgba(0,0,0,0.4); /* Black w/ opacity */\n}\n\n.modal-custom {\n\tmax-width: 100%;\n}\n\n/* Modal Content */\n.modal-content {\n  background-color: #fefefe;\n  /* margin: auto; */\n  padding: 20px;\n  /*border: 1px solid #888;*/\n  width: 60%;\n  max-width: 55rem;\n}\n\n.modal-content-ccpa {\n    margin: auto;\n    border: 1px solid #888;\n}\n\n/* The Close Button */\n.close {\n  color: #aaaaaa;\n  float: right;\n  font-size: 28px;\n  font-weight: bold;\n}\n\n.close:hover,\n.close:focus {\n  color: #000;\n  text-decoration: none;\n  cursor: pointer;\n}\n\n.opt-out:hover {\n\tcolor: #0A246A;\n\ttext-decoration: none;\n}\n\n.green.button {\n\tbackground-attachment:scroll;\n\tbackground-clip:border-box;\n\tbackground-color:rgb(0, 204, 0);\n\tbackground-image:none;\n\tbackground-origin:padding-box;\n\tbackground-position-x:0%;\n\tbackground-position-y:0%;\n\tbackground-repeat-x:;\n\tborder-bottom-color:rgba(0, 0, 0, 0);\n\tborder-bottom-left-radius:4px;\n\tborder-bottom-right-radius:4px;\n\tborder-bottom-style:solid;\n\tborder-bottom-width:1px;\n\tborder-image-outset:0px;\n\tborder-image-repeat:stretch;\n\tborder-image-slice:100%;\n\tborder-image-source:none;\n\tborder-image-width:1;\n\tborder-left-color:rgba(0, 0, 0, 0);\n\tborder-left-style:solid;\n\tborder-left-width:1px;\n\tborder-right-color:rgba(0, 0, 0, 0);\n\tborder-right-style:solid;\n\tborder-right-width:1px;\n\tborder-top-color:rgba(0, 0, 0, 0);\n\tborder-top-left-radius:4px;\n\tborder-top-right-radius:4px;\n\tborder-top-style:solid;\n\tborder-top-width:1px;\n\tbox-sizing:border-box;\n\tcolor:rgb(255, 255, 255);\n\tcursor:pointer;\n\tdisplay:block;\n\tfont-family:Lato, sans-serif;\n\tfont-size:14px;\n\tfont-weight:700;\n\theight:46px;\n\tline-height:14px;\n\tmargin-bottom:14px;\n\tmargin-left:0px;\n\tmargin-right:0px;\n\tmargin-top:0px;\n\tpadding-bottom:15px;\n\tpadding-left:15px;\n\tpadding-right:15px;\n\tpadding-top:15px;\n\tposition:relative;\n\ttext-align:center;\n\ttext-decoration-color:rgb(255, 255, 255);\n\ttext-decoration-line:none;\n\ttext-decoration-style:solid;\n\ttext-size-adjust:100%;\n\ttransition-delay:0s, 0s;\n\ttransition-duration:0.125s, 0.125s;\n\ttransition-property:background-color, color;\n\ttransition-timing-function:ease-out, ease-out;\n\tvertical-align:middle;\n\twidth:333px;\n\t-webkit-appearance:none;\n\t-webkit-font-smoothing:antialiased;\n}\n\n#ccpa-modal .ccpa-modal-inner a {\ndisplay: flex;\njustify-content: center;\nalign-items: center;\nwidth: 100%;\n}\n\n\n#ccpa-modal .ccpa-modal-inner h3 {\n\tpadding-bottom: 1rem;\n\tline-height: 1.4;\n\tmargin-top: 0;\n\tmargin-bottom: 0.5rem;\n}\n\n#ccpa-modal .modal-custom {\n\tmax-width: 100%;\n\twidth: 60%;\n}\n\n#ccpa-modal b {\n\tfont-family: \"Lato\",sans-serif;\n\tfont-weight: normal;\n\tline-height: 1.5;\n\tcolor: #333;\n\t-webkit-font-smoothing: antialiased;\n}\n\n.overlay-custom {\n\tdisplay: none;\n\tposition: fixed;\n\ttop: 0;\n\tleft: 0;\n\twidth: 100%;\n\tmax-width: 100%;\n\twidth: 100%;\n\theight: 100%;\n\tbackground: rgba(0, 0, 0, .7);\n\tz-index: 100;\n}\n.overlay-custom.modal-custom#ccpa-modal {\n\twidth: 100%;\n}\n\n#ccpa-modal {\n\twidth: 100%;\n}\n"
