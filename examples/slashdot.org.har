            "compression": 8592,
            "mimeType": "text/plain",
            "text": "\n\n\n    \n    \n        \n        \n        <link rel=\"stylesheet\" href=\"//a.fsdn.com/con/css/top.css?1784303847\" />\n        \n        \n            \n    \n    \n    \n    \n    \n    \n    \n    \n    <link rel=\"stylesheet\" href=\"//a.fsdn.com/con/css/inter-tight.css?1784303847\">\n\n        \n        \n            \n        \n    \n\n\n\n\n\n\n\n\n    \n    \n    \n        \n    \n    \n    \n\n\n<section id=\"topbar-tool\" data-banner-name=\"retool\" data-nosnippet style=\"display:none\">\n  <div class=\"row\">\n    <div class=\"heading-wrapper\">\n        \n    \n    <svg width=\"116\" height=\"28\" viewBox=\"0 0 321 63\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><g clip-path=\"url(#a)\" fill=\"#E9EBDF\"><path d=\"M136.776 61.537h-11.664l-25.49-26.056H94.87v26.056h-8.64V.739h28.945c12.183 0 19.441 6.514 19.441 17.371s-7.258 17.37-19.441 17.37h-4.32zm-10.8-43.427c0-6.166-3.457-9.988-10.801-9.988H94.87v19.976h20.305c7.344 0 10.801-3.821 10.801-9.988m32.923 44.73c-13.825 0-22.466-10.336-22.466-23.885s8.641-23.885 22.034-23.885c10.8 0 17.281 6.08 20.132 15.113 1.037 3.387 1.469 7.121 1.469 10.943v.869h-35.34c.259 7.295 5.617 14.33 14.171 14.33 7.344 0 10.714-4.255 11.405-7.382h8.9c-2.074 7.383-8.986 13.897-20.305 13.897m-14.171-27.36h27.045c-.432-7.816-4.579-13.896-13.306-13.896s-13.48 6.514-13.739 13.897m35.767-12.159v-6.948h10.801V5.95h8.295v10.423h11.664v6.948h-11.664V50.68c0 3.04.864 4.082 3.888 4.082h7.776v6.775h-9.504c-7.863 0-10.455-3.909-10.455-10.857V23.32zm54.609-8.252c13.825 0 22.897 10.336 22.897 23.885s-9.072 23.885-22.897 23.885-22.898-10.336-22.898-23.885 9.073-23.885 22.898-23.885m0 6.948c-9.418 0-14.603 7.817-14.603 16.937s5.185 16.936 14.603 16.936 14.602-7.817 14.602-16.936-5.184-16.937-14.602-16.937m49.458-6.948c13.825 0 22.897 10.336 22.897 23.885s-9.072 23.885-22.897 23.885-22.897-10.336-22.897-23.885 9.072-23.885 22.897-23.885m0 6.948c-9.418 0-14.603 7.817-14.603 16.937s5.185 16.936 14.603 16.936 14.603-