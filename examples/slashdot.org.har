            "text": "/* global $, anonEv */\nfunction maxnav_loader(){\n        fetch('https://sourceforge.net/about/maxnav')\n        .then(response => response.text())\n        .then(text => {\n            var searchContainer = document.getElementById('main-search') || document.getElementById('main-top-nav-wrapper');\n            searchContainer.insertAdjacentHTML('afterbegin', text);\n            // keep in sync with chrome.js\n            $('#main-nav-badge-link').off('click').on('click', function (e) {\n                var label = $(this).data('label') || 'MaxNav';\n                var client = $(this).data('client') || 'maxnav';\n                anonEv({source: 'sf', client}, ['trackEvent', 'Nav Menu', label]);\n            });\n        });\n}\nmaxnav_loader();\n"
