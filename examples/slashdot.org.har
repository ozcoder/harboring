"none\">\n        <rect x=\"1.5\" y=\"3\" width=\"15\" height=\"12\" rx=\"2\"\n              stroke=\"#ccc\" stroke-width=\"1.4\" fill=\"none\"/>\n        <line x1=\"1.5\" y1=\"6.5\" x2=\"16.5\" y2=\"6.5\" stroke=\"#ccc\" stroke-width=\"1.1\"/>\n      </svg>\n      Landing page\n    </button>\n    <button data-full-prompt=\"Build a dashboard with analytics and charts\">\n      <svg width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" fill=\"none\">\n        <circle cx=\"9\" cy=\"9\" r=\"6.5\" stroke=\"#ccc\" stroke-width=\"1.4\" fill=\"none\"/>\n        <path d=\"M9 4.5V9L12 11\" stroke=\"#ccc\" stroke-width=\"1.3\" stroke-linecap=\"round\"/>\n      </svg>\n      Dashboard\n    </button>\n    <button data-full-prompt=\"Create a portfolio website to showcase my work\">\n      <svg width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" fill=\"none\">\n        <rect x=\"2\" y=\"2\" width=\"14\" height=\"14\" rx=\"2\"\n              stroke=\"#ccc\" stroke-width=\"1.4\" fill=\"none\"/>\n        <path d=\"M2 7L9 11L16 7\" stroke=\"#ccc\" stroke-width=\"1.2\" fill=\"none\"/>\n      </svg>\n      Portfolio\n    </button>\n    <button data-full-prompt=\"Build a corporate website with team pages and services\">\n      <svg width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" fill=\"none\">\n        <rect x=\"1\"  y=\"1\"  width=\"7\" height=\"7\" rx=\"1.2\" stroke=\"#ccc\" stroke-width=\"1.3\" fill=\"none\"/>\n        <rect x=\"10\" y=\"1\"  width=\"7\" height=\"7\" rx=\"1.2\" stroke=\"#ccc\" stroke-width=\"1.3\" fill=\"none\"/>\n        <rect x=\"1\"  y=\"10\" width=\"7\" height=\"7\" rx=\"1.2\" stroke=\"#ccc\" stroke-width=\"1.3\" fill=\"none\"/>\n        <rect x=\"10\" y=\"10\" width=\"7\" height=\"7\" rx=\"1.2\" stroke=\"#ccc\" stroke-width=\"1.3\" fill=\"none\"/>\n      </svg>\n      Corporate\n    </button>\n    <button data-full-prompt=\"Build a SaaS application with user accounts and billing\">\n      <svg width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" fill=\"none\">\n        <path d=\"M3.5 13C3.5 9 6.5 5 9 5C11.5 5 14.5 9 14.5 13\"\n              stroke=\"#ccc\" stroke-width=\"1.4\" fill=\"none\" stroke-linecap=\"round\"/>\n        <circle cx=\"9\" cy=\"5\" r=\"1.8\" stroke=\"#ccc\" stroke-width=\"1.2\" fill=\"none\"/>\n      </svg>\n      SaaS\n    </button>\n    <button data-full-prompt=\"Create a link in bio page for my social media profiles\">\n      <svg width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" fill=\"none\">\n        <circle cx=\"9\" cy=\"6\" r=\"3.2\" stroke=\"#ccc\" stroke-width=\"1.4\" fill=\"none\"/>\n        <path d=\"M2.5 16C2.5 12.5 5.5 10 9 10C12.5 10 15.5 12.5 15.5 16\"\n              stroke=\"#ccc\" stroke-width=\"1.4\" fill=\"none\" stroke-linecap=\"round\"/>\n      </svg>\n      Link in bio\n    </button>\n\n  \n  </div>\n  <div class=\"more-options-header\">\n    <span class=\"more-title\"></span> \n  </div>\n  <div class=\"more-pills\">\n  \n      \n    <div class=\"vibe-template-card\"\n         data-full-prompt=\"Build an app that sends email for low inventory levels in Shopify\">\n      <div class=\"vibe-template-illustration\">\n        <svg width=\"100%\" height=\"90\" viewBox=\"0 0 200 90\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n          <rect x=\"10\" y=\"8\"  width=\"110\" height=\"70\" rx=\"6\" fill=\"#ede9fe\"/>\n          <rect x=\"10\" y=\"8\"  width=\"110\" height=\"16\" rx=\"6\" fill=\"#c4b5fd\"/>\n          <rect x=\"18\" y=\"28\" width=\"70\"  height=\"8\"  rx=\"3\" fill=\"#c4b5fd\" opacity=\"0.5\"/>\n          <rect x=\"18\" y=\"40\" width=\"50\"  height=\"8\"  rx=\"3\" fill=\"#c4b5fd\" opacity=\"0.5\"/>\n          <rect x=\"18\" y=\"52\" width=\"60\"  height=\"8\"  rx=\"3\" fill=\"#c4b5fd\" opacity=\"0.3\"/>\n          <rect x=\"85\" y=\"38\" width=\"80\"  height=\"44\" rx=\"6\" fill=\"#a78bfa\"/>\n          <ellipse cx=\"125\" cy=\"54\" rx=\"12\" ry=\"12\" fill=\"white\" opacity=\"0.25\"/>\n          <path d=\"M125 46c-5 0-9 3.6-9 8v3l-2 2v1h22v-1l-2-2v-3c0-4.4-4-8-9-8z\" fill=\