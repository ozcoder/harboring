tElementById('sitewide-top-banner-placeholder') || document.getElementById('top-banner-placeholder')\n            if (placeholder) {\n                placeholder.style.display = 'none';\n            }\n            return;\n        }\n        let delay = 0;\n        const configs = {\n            slashdot: {\n                stickyTopOffset: '0px',\n                stickyTriggerEl: '.nav-wrap',\n                footerEl: 'footer#ft',\n                basementEl: 'footer#ft .grid_14'\n            },\n            slashcontent: {\n                stickyTopOffset: '67px',\n                stickyTriggerEl: '.l-header-nav',\n                footerEl: 'footer.sandiego',\n                basementEl: '.l-nav-bottom'\n            },\n            sfblog: {\n                stickyTopOffset: '39px',\n                stickyTriggerEl: '.l-header-nav',\n                footerEl: 'footer.sandiego',\n                basementEl: '.l-nav-bottom'\n            },\n            sfarticles: {\n                stickyTopOffset: '39px',\n                stickyTriggerEl: '.l-header-nav',\n                footerEl: 'footer.sandiego',\n                basementEl: '.l-nav-bottom'\n            },\n            linuxjournal: {\n                stickyTopOffset: '0px',\n                stickyTriggerEl: '.l-header-nav',\n                footerEl: 'footer.lj-footer',\n                basementEl: 'footer.lj-footer .l-footer-inner'\n            },\n        };\n        const config = configs[source];\n        if (!config) {\n            return;\n        }\n        if (source !== 'linuxjournal') {\n            unit_loader({\n                url: `${_host}/about/sitewide_float`,\n                footerEl: config.footerEl,\n                basementEl: config.basementEl, // the element the ad unit anchors to\n                delay: delay,\n                source: source,\n                insertPosition: 'afterbegin'\n            });\n        }\n        top_banner_loader({\n            url: `${_host}/about/sitewide_top`,\n            sticky_url: `${_host}/about/sitewide_top_sticky`,\n            source: source,\n            shadowRoot: true,\n            insertPosition: 'beforeend',\n            stickyTriggerEl: config.stickyTriggerEl,\n            stickyTopOffset: config.stickyTopOffset,\n        });\n    }\n})()\n/*jshint ignore:end*/\n"
