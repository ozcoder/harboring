"><a class=\"ico close\" onclick=\"hide_modal_box(); return false;\" href=\"#\"><span>Close</span></a></span>\n\t\t  <h3 class=\"pf\"><div id=\"logo\"><a href=\"//slashdot.org\">Slashdot</a></div><span id=\"preference_title\"></span></h3>\n      </header>\n</div>\n\t\n\t<script type=\"text/javascript\">\nwindow.google_analytics_uacct = \"UA-199823890-2\";\n\nvar _gaq = _gaq || [];\n\n\n\n\n\n  _gaq.push(['_setAccount', 'UA-199823890-2']);\n  _gaq.push(['_setDomainName', '.slashdot.org']);\n\n\t\n\t\t_gaq.push(['_addIgnoredRef', 'slashdot.org']);\n\t\n\n\n  _gaq.push(['_setCustomVar', 1, 'User Type',  'Anon', 3]);\n\t\n\t_gaq.push(['_setCustomVar', 2, 'Page','index2', 3]);\n\n\t\n\n\n\n// track beta behavior for user\nvar betamatches = document.cookie.match(/betagroup=(-?\\d+)/);\n\nif(betamatches && betamatches[1]) {\n  if(betamatches[1] == -1) {\n    _gaq.push(['_setCustomVar', 3, 'Beta-Usage','opt-out', 3]);\n  } else {\n    _gaq.push(['_setCustomVar', 3, 'Beta-Usage','unredirected', 3]);\n  }\n}\n\n\n\n  _gaq.push(['_trackPageview']);\n  _gaq.push(['_trackPageLoadTime']);\n\n\nbizx.cmp.ifConsent({purposes: ['storage', 'measurement'], vendors: 'google-analytics'}, function () {\n  (function() {\n    var ga = document.createElement('script'); ga.type = 'text/javascript'; ga.async = true;\n    ga.src = ('https:' == document.location.protocol ? 'https://ssl' : 'http://www') + '.google-analytics.com/ga.js';\n    var s = document.getElementsByTagName('script')[0]; s.parentNode.insertBefore(ga, s);\n  })();\n});\n</script>\n\n<!-- CCM GA Push -->\n<script>\n    if (typeof _ml !== 'undefined' && _ml.us) {\n        if (_ml.us.tp && _ml.us.tp.length > 0) {\n            ga('set', 'dimension2', _ml.us.tp[0]);\n        }\n        if (_ml.us.pc && _ml.us.pc.length > 0) {\n            ga('set', 'dimension7', _ml.us.pc[0]);\n        }\n        ga('set', 'dimension3', _ml.us.ind);\n        ga('set', 'dimension4', _ml.us.cr);\n        ga('set', 'dimension5', _ml.us.cs);\n        ga('set', 'dimension6', _ml.us.dm);\n        ga('set', 'dimension8', _ml.us.sn);\n    }\n</script>\n\n<!-- Sticky Ads -->\n<script type=\"text/javascript\">\nvar topBannerViewed = false;\nfunction initSticky(){\n    if (SD?.Ads?.acceptable_ads_active) {\n        return;\n    }\n        \n    if($('#div-gpt-ad-728x90_a').length > 0 && $('#div-gpt-ad-300x250_a').length > 0 && window.outerWidth >= 1070 && !sdAdBlockActive){\n        $(window).scroll(function(){\n\t\t\tvar y = $(document).scrollTop();\n\t\t\tvar z =  y + window.outerHeight;\n\t\t\tvar navOffset = 0;\n\t\t\tvar offset = [\n\t\t\t\t$('.nav-wrap').outerHeight(true),\n\t\t\t\t$('.nav-secondary-wrap').outerHeight(true)\n\t\t\t];\n\t\t\tfor(row in offset){\n\t\t\t\tif(offset[row]) navOffset = navOffset + parseInt(offset[row]);\n\t\t\t}\n\t\t\t$('.adwrap-unviewed').each(function(){\n\t\t\t\tvar cls = 'adwrap-sticky';\n\t\t\t\tvar toggleCls = 'adwrap';\n\t\t\t\t\n\t\t\t\tif($(this).hasClass('railad')) {\n\t\t\t\t\tif(topBannerViewed){\n\t\t\t\t\t\tvar topPixels = $(this).offset().top;\n\t\t\t\t\t\tnavOffset += $('.adwrap').outerHeight();\n\t\t\t\t\t\tif(y >= topPixels && y >= navOffset){\n\t\t\t\t\t\t\t$('#slashboxes').css('top', 0).css('position','sticky').css('right',13);\n\t\t\t\t\t\t} else {\n\t\t\t\t\t\t\t$('#slashboxes').removeAttr('style');\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t\treturn;\n\t\t\t\t}\n\t\t\t\tvar topPixels = $(this).offset().top;\n\t\t\t\tif(y >= topPixels && y >= navOffset){\n\t\t\t\t\t$(this).addClass(cls);\n\t\t\t\t\t$(this).removeClass('adwrap');\n\t\t\t\t\tif(cls == 'adwrap-sticky') { //top banner\n\t\t\t\t\t\ttopBannerViewed = false;\n\t\t\t\t\t\t$('#slashboxes').css('top',$(this).outerHeight() || 0).css('position','sticky').css('right',13);\n\t\t\t\t\t}\n\t\t\t\t\tif(topBannerViewed) {\n\t\t\t\t\t\t\n\t\t\t\t\t\t$('#slashboxes').css('top', 0).css('position','sticky').css('right',13);\n\t\t\t\t\t}\n\t\t\t\t}else{\n\t\t\t\t\t\n\t\t\t\t\t$(this).removeClass(cls);\n\t\t\t\t\t$(this).addClass(toggleCls);\n\t\t\t\t\t$('#slashboxes').removeAttr('style');\n\t\t\t\t}\n\t\t\t});\n\t\t\tif($('.adwrap-viewed-banner').length > 0){\n\t\t\t\t\n\t\t\t\ttopBannerViewed = true;\n\t\t\t\t$('.adwrap-viewed-banner').removeClass('adwrap-unviewed').removeClass('adwrap-sticky').addClass('adwrap');\n\t\t\t}\n\t\t\tif($('.adwrap-viewed-railad').length > 0){\n\t\t\t\t\n            \t$('.adwrap-viewed-railad').removeClass('adwrap-unviewed').removeClass('adwrap-railad-sticky');\n                $('#slashboxes').removeAttr('style');\n            }\n        });\n    }\n}\nbizx.cmp.ifConsent({purposes: 'all', vendors: 'google-ads'}, function () {\n\tif (!sdAdBlockActive) {\n\t\tinitSticky();\n\t}\n\tif (SD?.Ads?.acceptable_ads_active) {\n\t\t// similar to remove* code above in initSticky\n\t\t$('.adwrap-unviewed').removeClass('adwrap-unviewed').removeClass('adwrap-sticky').addClass('adwrap').removeClass('adwrap-railad-sticky');\n\t\t$('#slashboxes').removeAttr('style');\n\t}\n});\n</script>\n\n<style>\n#slashboxes .ntv-preview-img-wrapper {\n    display: block;\n    margin: 0 auto !important;\n    width: 100%;\n    float: none;\n    text-align: center;\n}\n#slashboxes strong {\n    margin-bottom: -5px;\n    display: block;\n}\n#slashboxes .ntv-preview-img-wrapper {background: #F7F7F7;}\n#slashboxes .nel-image {\n    float: none;\n    margin-top: 10px;\n}\n#slashboxes .p.ntv-body {\n    text-align: left;\n    border-top: 1px solid #CCCCCC;\n}\n\n#slashboxes .p.ntv-body strong {\n    display: block;\n}\n\n#slashboxes .p.ntv-body .nel-button {\n    width: 100%;\n    text-align: center;\n    margin: 15px 0;\n    padding: 8px;\n}\n\n#slashboxes .p.ntv-body {\n    background: #fff;\n    margin: 0;\n    padding: 10px 10px 1px 10px;\n}\n#slashboxes article:first-child {\n    border-radius: 0px !important;\n    padding-top: 1;\n}\n#slashboxes article:first-child header {\n    border-radius: 0px !important;\n}\n#slashboxes article:first-child h2.story {\n    padding-left: 10px;\n    background: #6D4634;\n}\n\n#slashboxes .details {\n    display: none;\n}\n#slashboxes .ntv-sponsored-disclaimer {\n    position: relative;\n    top: 0;\n    background: #6D4634;\n    padding-left: 10px;\n    padding-top: 10px;\n    margin-left: 0;\n}\n#slashboxes .ntv-sponsored-disclaimer:before {\n    display: none;\n}\n#slashboxes .ntv-sponsored-question {\n    display: none;\n}\n#slashboxes .ntv-sponsored-disclaimer a {\n    float: none;\n    text-transform: uppercase;\n}\n</style>\n<!-- Piwik -->\n<script type=\"text/javascript\">\n  var _paq = _paq || [];\n  _paq.push([\"setCookieDomain\", \"*.slashdot.org\"]);\n  _paq.push(['trackPageView']);\n  _paq.push(['enableLinkTracking']);\nfunction initPiwik() {\n  (function() {\n    var u=\"//analytics.slashdotmedia.com/\";\n    _paq.push(['setTrackerUrl', u+'sd.php']);\n    _paq.push(['setSiteId', 40]);\n    var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];\n    g.type='text/javascript'; g.async=true; g.defer=true; g.src=u+'sd.js'; s.parentNode.insertBefore(g,s);\n  })();\n}\n\nfunction initNels() {\n\n    if(window.location.pathname == '/'){\n        var nelId = (location.search.split('nel_id=')[1] || '').split('&')[0];\n        var url = '/ajax.pl?op=nel';\n        if(nelId){\n            url += '&nel_id='+nelId;\n        }\n        $.ajax({\n            url: url,\n            type: 'POST',\n            success: function(html){\n                $('#firehoselist article').eq(1).after(html);\n            }\n        });\n    }\n\n    function showVerticalNEL() {\n        let res = false;\n        if(window.location.pathname.indexOf('/story/') >= 0){ // story\n            res = true;\n        }\n        if(window.location.pathname.indexOf('/recent') >= 0 ||\n            window.location.pathname.indexOf('/popular') >= 0 ||\n            window.location.pathname.indexOf('/submission/') >= 0){ // submissions\n            res = true;\n        }\n        if(window.location.pathname === '/'){ // home\n            res = true;\n        }\n        return res;\n    }\n    if (showVerticalNEL()) {\n        var nelId = (location.search.split('nel_id=')[1] || '').split('&')[0];\n        var url = '/ajax.pl?op=nel';\n        if(nelId){\n            url += '&nel_id='+nelId;\n        }\n        $.ajax({\n            url: url,\n            type: 'POST',\n            success: function(html){\n                $('#slashboxes').eq(0).prepend(html);\n                $('#slashboxes .ntv-sponsored-disclaimer a span:first-child').html('Featured Content');\n            }\n        });\n    }\n    //announcement NEL\n    if(document.getElementById('announcementText')){\n      $('#announcementText').hide();\n      var hlUrl = '/ajax.pl?op=hl_nel';\n      if(nelId){\n        hlUrl += '&nel_id='+nelId;\n      }\n      $.ajax({\n        url: hlUrl,\n        type: 'POST',\n        success: function(html){\n          if(html.length < 10){\n            $('#announcementText').show();\n            return;\n          }\n          $('#announcementText').html(html).show();\n        },\n        error: function () {\n          $('#announcementText').show();\n        }\n      });\n    }\n    document.addEventListener('click', (e) => {\n      const el = e.target.closest('[data-dest]');\n      if (!el) return;\n      e.preventDefault();\n      e.stopPropagation();\n      const url = el.dataset.dest;\n      const target = el.dataset.target || '_self';\n      if (target === '_blank') {\n        window.open(url, '_blank', 'noopener,noreferrer');\n      }\n    });\n}\nlet tracking = false;\nbizx.cmp.ifConsent({purposes: ['storage', 'measurement'], vendors: 'sdm'}, initPiwik);\ninitNels();\nfunction trackNelImpressions() {\n  const nelimps = document.querySelectorAll('img[data-name=\"nel-impression\"]:not([data-nel-processed])');\n  nelimps.forEach((imp) => {\n    imp.setAttribute('data-nel-processed', '1'); // prevent re-processing\n    const imp_url = imp.getAttribute('data-source');\n    if (!imp_url) {\n        return;\n    }\n    imp.src = imp_url;\n  });\n}\nfunction startTracking(){\n    if (tracking) return;\n    tracking = true;\n    trackNelImpressions();\n}\nconst observer = new MutationObserver(function(mutations) {\n  if (!tracking) return;\n  for (const m of mutations) {\n    for (const node of m.addedNodes) {\n      if (node.nodeType !== 1) continue; // element only\n      trackNelImpressions(node);\n    }\n  }\n});\nobserver.observe(document.body, { childList: true, subtree: true });\n\nbizx.cmp.ifConsent({purposes: ['storage', 'measurement', 'ads'], vendors: 'sdm'}, function(){\n    startTracking();\n});\n\n<!-- 6sense -->\nbizx.cmp.ifConsent({purposes: 'all', vendors: '6sense'}, async() => {\n    (function(){\n    var s = document.getElementsByTagName(\"script\")[0];\n    var b = document.createElement(\"script\");\n    b.type = \"text/javascript\";\n    b.async = true;b.defer=true;b.id='6senseWebTag';\n    b.src = \"https://j.6sc.co/j/58729049-be80-466a-9abf-b3911430bbd8.js\";\n    s.parentNode.insertBefore(b, s);\n    })();\n})\n</script>\n\n\n\n<script src=\"//a.fsdn.com/con/js/sandiego/maxnav.js?2026-07-06\"></script>\n<script data-source=\"slashdot\" src=\"//a.fsdn.com/con/js/sandiego/floating-unit.js?2026-07-06\"></script>\n\t<script id=\"after-content\" type=\"text/javascript\">\n(function( $, fn, console ){\n\t$ && fn && $(function(){ fn($, console); });\n})(window.jQuery, window.pageload_done, window.console);\n</script>\n\t<img src=\"//slashdot.org/sponsorad.jpg?t=20260720\" alt=\"\">\t<img src=\"//slashdot.org/purple.gif?t=20260720\" alt=\"\">\n\t<script type='text/javascript'>\n\tif(!document.location.href.match(/source=autorefresh/)) {\n\t\tdocument.write('<img src=\"//slashdot.org/images/js.gif?195\">');\n\t}\n</script>\n<noscript>\n\t<img src=\"//slashdot.org/images/njs.gif?241\">\n</noscript>\n\t<div class=\"busy genericspinner hide\"><span>Working...</span></div>\n\n\t    <script>\n            var regular_opt_out_link = true;