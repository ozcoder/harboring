{"log":{"version":"1.2","creator":{"name":"Playwright","version":"1.59.1"},"browser":{"name":"chromium","version":"147.0.7727.15"},"pages":[{"startedDateTime":"2026-07-11T14:54:24.111Z","id":"page@e683219f5006ffe7e9ce979df39e0f8e","title":"HAR Priority test","pageTimings":{"onContentLoad":2072,"onLoad":5819,"_TTFB":null,"_LCP":1224}}],"entries":[{"pageref":"page@e683219f5006ffe7e9ce979df39e0f8e","startedDateTime":"2026-07-11T14:54:24.242Z","time":283.553,"request":{"method":"GET","url":"http://127.0.0.1:33935/index.html","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7"},{"name":"Upgrade-Insecure-Requests","value":"1"},{"name":"User-Agent","value":"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/147.0.0.0 Safari/537.36"},{"name":"x-telescope-id","value":"b1578e18-9aac-424a-a598-1d74de73146c"},{"name":"sec-ch-ua","value":"\"Chromium\";v=\"147\", \"Not.A/Brand\";v=\"8\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Linux\""}],"queryString":[],"headersSize":473,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Connection","value":"keep-alive"},{"name":"Content-Encoding","value":"gzip"},{"name":"Content-Type","value":"text/html"},{"name":"Date","value":"Sat, 11 Jul 2026 14:54:24 GMT"},{"name":"Keep-Alive","value":"timeout=5"},{"name":"Transfer-Encoding","value":"chunked"}],"content":{"size":3270,"mimeType":"text/html","compression":2416,"text":"<!DOCTYPE html>\n<html>\n  <head>\n    <title>HAR Priority test</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n    <script defer src=\"script.js\" type=\"text/javascript\"></script>\n  </head>\n  <body>\n    <h1>HAR Priority test</h1>\n    <p>\n      <img alt=\"telescope icon\" width=\"51\" height=\"52\" src=\"telescope.png?first0\" />\n      <img alt=\"telescope icon\" width=\"51\" height=\"52\" src=\"telescope.png?first1\" />\n      <img alt=\"telescope icon\" width=\"51\" height=\"52\" src=\"telescope.png?first2\" />\n      <img alt=\"telescope icon\" width=\"51\" height=\"52\" src=\"telescope.png?first3\" />\n      <img alt=\"telescope icon\" width=\"51\" height=\"52\" src=\"telescope.png?first4\" />\n      <img alt=\"telescope icon\" width=\"51\" height=\"52\" src=\"telescope.png?first5\" />\n      <img alt=\"telescope icon\" width=\"51\" height=\"52\" src=\"telescope.png?first6\" />\n      <img alt=\"telescope icon\" width=\"51\" height=\"52\" src=\"telescope.png?first7\" />\n      <img alt=\"telescope icon\" width=\"51\" height=\"52\" src=\"telescope.png?first8\" />\n      <img alt=\"telescope icon\" width=\"51\" height=\"52\" src=\"telescope.png?first9\" />\n    </p>\n    <p>\n      <img alt=\"large telescope icon\" width=\"102\" height=\"104\" src=\"telescope.png?first11\" />\n      <img alt=\"large telescope icon\" width=\"102\" height=\"104\" src=\"telescope.png?first12\" />\n      <img alt=\"large telescope icon\" width=\"102\" height=\"104\" src=\"telescope.png?first13\" />\n      <img alt=\"large telescope icon\" width=\"102\" height=\"104\" src=\"telescope.png?first14\" />\n      <img alt=\"large telescope icon\" width=\"102\" height=\"104\" src=\"telescope.png?first15\" />\n    </p>\n    <p>\n      This test page is to check the initial priority and final priority of the\n      image requests are recorded correctly in the HAR file. The <em>first</em>\n      sets of images are <span class=\"em\">above-the-fold</span> and so the\n      browser will increase their priority.  <em>At the moment, Chromium\n      based browsers increase the priority of the first <b>5</b> large\n      (&gt; 10,000 pixels) images to <strong>Medium</strong></em> before\n      further increasing them.\n    </p>\n    <p>\n      The <em>second</em> image is <span class=\"em\">below-the-fold</span> and\n      so should have a <strong>Low</strong> priority. The <em>third</em> image\n      asks the browser to increase it's priority and so <u>should not</u> have a\n      <strong>Low</strong> priority. The final image should have the default\n      <strong>Low</strong> priority that images\n      <span class=\"em\">below-the-fold</span> get.\n    </p>\n    <h2>Second image</h2>\n    <img alt=\"large telescope icon\" width=\"51\" height=\"52\" src=\"telescope.png?second\" />\n    <h2>Third image</h2>\n    <img alt=\"large telescope icon\" width=\"51\" height=\"52\" src=\"telescope.png?third\" fetchpriority=\"high\" />\n    <h2>Fourth image</h2>\n    <img alt=\"large telescope icon\" width=\"51\" height=\"52\" src=\"telescope.png?fourth\" />\n    <h2>Fifth image</h2>\n    <img alt=\"telescope icon\" width=\"51\" height=\"52\" src=\"\" id=\"fifth\" />\n    <script type=\"text/javascript\">\n      if (document.location.hash === \"#h1\") {\n        const theFifth = document.getElementById('fifth');\n        theFifth.src = \"telescope.png?third\";\n        await fetch(\"telescope.png?third\", { priority: \"low\" });\n      }\n    </script>\n  </body>\n</html>\n"},"headersSize":180,"bodySize":854,"redirectURL":"","_transferSize":1034},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":268.885,"receive":14.668},"serverIPAddress":"127.0.0.1","_serverPort":33935,"_securityDetails":{},"_dns_start":-1,"_dns_end":-1,"_connect_start":-1,"_connect_end":-1,"_secure_start":-1,"_secure_end":-1,"_request_start":0.805,"_request_end":269.69,"_response_start":269.69,"_response_end":284.358,"_resourceType":"document","_initialPriority":"VeryHigh","_priority":"VeryHigh"},{"pageref":"page@e683219f5006ffe7e9ce979df39e0f8e","startedDateTime":"2026-07-11T14:54:24.544Z","time":863.685,"request":{"method":"GET","url":"http://127.0.0.1:33935/style.css","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"text/css,*/*;q=0.1"},{"name":"User-Agent","value":"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/147.0.0.0 Safari/537.36"},{"name":"x-telescope-id","value":"05accb01-16b3-4dbd-97d1-c71b38c26da2"},{"name":"Referer","value":"http://127.0.0.1:33935/index.html"},{"name":"sec-ch-ua","value":"\"Chromium\";v=\"147\", \"Not.A/Brand\";v=\"8\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Linux\""}],"queryString":[],"headersSize":369,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Connection","value":"keep-alive"},{"name":"Content-Encoding","value":"gzip"},{"name":"Content-Type","value":"text/css"},{"name":"Date","value":"Sat, 11 Jul 2026 14:54:25 GMT"},{"name":"Keep-Alive","value":"timeout=5"},{"name":"Transfer-Encoding","value":"chunked"}],"content":{"size":2269,"mimeType":"text/css","compression":1325,"text":"/*****************************************************************************\n * This style file ideally should be more than one packet in size just to be\n * a little bit realistic.\n * At the moment, none of the styles actually matter for the priority test.\n * The main thing is the second.png image is pushed quite far below-the-fold\n * so it's initial priority will be Low. I tried to make the page look OK\n * and interesting incase somebody wants to screenshot it.\n ****************************************************************************/\n\n/*\n * Old paper colour AKA navajowhite\n **/\nbody {\n  background-color: #ffdead;\n}\n\nh1 {\n  font-family: san-serif;\n  text-align: center;\n  font-size: 3em;\n  font-family: fantasy;\n  letter-spacing: 0.07em;\n  word-spacing: 0.07em;\n}\n\nh2 {\n  font-family: san-serif;\n}\n\n/**\n * Make the paragraphs nice and big so the later images are pushed\n * below-the-fold even on big monitors. Try to make it look decent.\n * Note: Margins between paragraphs collapse.\n **/\np {\n  font-family: sans-serif;\n  font-size: 64px;\n  letter-spacing: .03em;\n  line-height: 1.2;\n  margin-top: 1em;\n  margin-right: 0.66em;\n  margin-bottom: 1em;\n  margin-left: 0.66em;\n  text-indent: 1em hanging;\n  text-wrap-style: pretty;\n  word-spacing: 0.07em;\n}\n\n/**\n * Modern interpretation of old book style paragraph first letter.\n **/\np::first-letter {\n  font-family: serif;\n  font-size: 1.7em;\n  line-height: 0.7;\n  vertical-align: sub;\n}\n\n/**\n * A little bit prettier.\n **/\nem, span.em {\n  font-family: serif;\n  font-size-adjust: 0.54;\n}\n\n/*\n * We do not want hypenated words to wrap in pieces.\n **/\nspan.em {\n  font-style: italic;\n  white-space: nowrap;\n}\n\nstrong {\n  font-family: monospace;\n  font-size: 1.1em;\n  letter-spacing: 0.05em;\n  text-shadow: 0.07em -0.07em 2px rgba(7, 7, 7, 7%);\n}\n\n/**\n * Bold should be tight\n */\nb {\n  letter-spacing: 0;\n}\n\n/**\n * Better underline positioning due to font metrics.\n **/\nu {\n  text-underline-position: from-font;\n}\n\n/**\n * A very faint translucent grey background\n **/\nimg {\n    background-color: rgba(7, 7, 7, 7%);\n}\n\n@media (max-width: 1024px) {\n  h1 {\n    font-size: 2.8em;\n  }\n\n  p {\n    font-size: 62px;\n  }\n}\n\n@media (max-width: 414px) {\n  h1 {\n    font-size: 2.6em;\n  }\n\n  p {\n    font-size: 60px;\n  }\n}\n"},"headersSize":179,"bodySize":944,"redirectURL":"","_transferSize":1123},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":800.132,"receive":63.553},"serverIPAddress":"127.0.0.1","_serverPort":33935,"_securityDetails":{},"_dns_start":-1,"_dns_end":-1,"_connect_start":-1,"_connect_end":-1,"_secure_start":-1,"_secure_end":-1,"_request_start":0.438,"_request_end":800.57,"_response_start":800.57,"_response_end":864.123,"_resourceType":"stylesheet","_initialPriority":"VeryHigh","_priority":"VeryHigh"},{"pageref":"page@e683219f5006ffe7e9ce979df39e0f8e","startedDateTime":"2026-07-11T14:54:24.551Z","time":1650.899,"request":{"method":"GET","url":"http://127.0.0.1:33935/script.js","httpVersion":"